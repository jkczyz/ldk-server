# Build stage
FROM eclipse-temurin:21-jdk AS builder

RUN apt-get update && apt-get install -y --no-install-recommends git unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN git clone --depth 1 --branch splicing-official https://github.com/ACINQ/eclair.git .
# Fix: only retransmit announcement_signatures for the initial funding when
# my_current_funding_locked actually refers to it, not when it refers to a splice.
RUN sed -i 's/val announcementSigs_opt = if (notAnnouncedYet || channelReestablish.retransmitAnnSigs) {/val retransmitAnnSigsForInitialFunding = channelReestablish.retransmitAnnSigs \&\& channelReestablish.myCurrentFundingLocked_opt.contains(c.fundingTxId)\n        val announcementSigs_opt = if (notAnnouncedYet || retransmitAnnSigsForInitialFunding) {/' \
    eclair-core/src/main/scala/fr/acinq/eclair/channel/fsm/Channel.scala
RUN ./mvnw package -pl eclair-node -am -DskipTests -q

# Extract the distribution ZIP to a known location
RUN mkdir /opt/eclair && \
    unzip -q eclair-node/target/eclair-node-*-bin.zip -d /tmp/eclair-dist && \
    mv /tmp/eclair-dist/eclair-node-*/* /opt/eclair/

# Runtime stage
FROM eclipse-temurin:21-jre

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash curl jq \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/eclair /opt/eclair
RUN chmod +x /opt/eclair/bin/eclair-node.sh

RUN mkdir -p /data/eclair

EXPOSE 9735 8080

ENTRYPOINT ["/opt/eclair/bin/eclair-node.sh", "-Declair.datadir=/data/eclair", "-Declair.allow-unsafe-startup=true", "-Declair.printToConsole"]
