# Build stage
FROM rust:1.85-bookworm AS builder

WORKDIR /build
COPY . .

# Fetch dependencies first, then patch LDK source
RUN cargo fetch
# Fix: don't generate announcement_signatures during reestablish when a splice
# promotion is about to happen via my_current_funding_locked referring to a
# pending splice funding.
RUN find /usr/local/cargo/git -path "*/lightning/src/ln/channel.rs" \
    -exec grep -l "inferred_splice_locked" {} \; \
    | head -1 \
    | xargs sed -i 's/let announcement_sigs = self\.get_announcement_sigs(node_signer, chain_hash, user_config, best_block\.height, logger);/let splice_promotion_pending = msg.my_current_funding_locked.as_ref().map(|fl| self.pending_funding().iter().any(|f| f.get_funding_txid() == Some(fl.txid))).unwrap_or(false); let announcement_sigs = if splice_promotion_pending { None } else { self.get_announcement_sigs(node_signer, chain_hash, user_config, best_block.height, logger) };/'

RUN cargo build --release -p ldk-server -p ldk-server-cli

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/ldk-server /usr/local/bin/ldk-server
COPY --from=builder /build/target/release/ldk-server-cli /usr/local/bin/ldk-server-cli
COPY interop-tests/ldk-server-config.toml /etc/ldk-server/config.toml

RUN mkdir -p /data/ldk-server

EXPOSE 3001 3002

ENTRYPOINT ["ldk-server", "/etc/ldk-server/config.toml"]
